@import "tailwindcss";

@theme {
  --animate-float: float 6s ease-in-out infinite;

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-20px); }
  }
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  padding: 0;
  background-color: #000;
  color: #fff;
  font-family: 'Inter', system-ui, -apple-system, sans-serif;
}

[data-aos="drop-bounce"] {
  opacity: 0;
}
[data-aos="drop-bounce"].aos-animate {
  animation: dropBounce 1.2s cubic-bezier(0.28, 0.84, 0.42, 1) forwards;
}

@keyframes dropBounce {
  0% { transform: translateY(-300px); opacity: 0; }
  50% { transform: translateY(0); opacity: 1; }
  65% { transform: translateY(-40px); opacity: 1; }
  80% { transform: translateY(0); opacity: 1; }
  90% { transform: translateY(-15px); opacity: 1; }
  100% { transform: translateY(0); opacity: 1; }
}

:root { --accent-red:#ff2a2a; }
* { box-sizing: border-box; }
::selection { background: #ff2a2a; color: #fff; }
body { overflow-x:hidden; }
a { -webkit-tap-highlight-color: transparent; }
.hero-grid { background-image: linear-gradient(rgba(255,255,255,.045) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.045) 1px, transparent 1px); background-size: 72px 72px; mask-image: linear-gradient(to bottom, black, transparent 88%); }
.hero-cursor-glow { position:fixed; width:260px; height:260px; transform:translate(-50%,-50%); border-radius:50%; pointer-events:none; z-index:5; background:radial-gradient(circle,rgba(255,42,42,.12),transparent 68%); filter:blur(8px); }
.text-outline { color:transparent; -webkit-text-stroke:1px rgba(255,255,255,.8); }
.hero-btn { display:inline-flex; align-items:center; gap:.8rem; padding:.9rem 1.25rem; border-radius:999px; font-size:.82rem; font-weight:800; letter-spacing:.02em; transition:.35s ease; }
.hero-btn-primary { background:#fff; color:#050505; }
.hero-btn-primary:hover { transform:translateY(-3px); box-shadow:0 14px 40px rgba(255,255,255,.12); }
.hero-btn-ghost { border:1px solid rgba(255,255,255,.18); background:rgba(255,255,255,.035); color:#fff; backdrop-filter:blur(14px); }
.hero-btn-ghost:hover { border-color:rgba(255,42,42,.6); background:rgba(255,42,42,.12); transform:translateY(-3px); }
.hero-icon-btn { width:46px; height:46px; border-radius:50%; display:grid; place-items:center; border:1px solid rgba(255,255,255,.14); color:rgba(255,255,255,.65); transition:.35s ease; }
.hero-icon-btn:hover { color:#fff; border-color:rgba(255,42,42,.6); transform:translateY(-3px) rotate(-6deg); }
.ask-orbit { position:absolute; width:300px; height:300px; border:1px solid rgba(255,255,255,.12); border-radius:50%; animation:spin 18s linear infinite; }
.ask-orbit:before { content:''; position:absolute; width:7px; height:7px; border-radius:50%; background:#ff2a2a; top:16px; left:50%; box-shadow:0 0 24px #ff2a2a; }
.ask-orbit span { position:absolute; top:40px; right:30px; font-size:9px; letter-spacing:.35em; color:rgba(255,255,255,.35); }
.ask-orbit-2 { width:210px; height:210px; border-style:dashed; animation-duration:12s; animation-direction:reverse; }
.ask-orbit-2 span { top:auto; bottom:25px; right:auto; left:22px; color:#ff6b6b; }
.ask-core { width:116px; height:116px; display:grid; place-items:center; border-radius:50%; background:radial-gradient(circle at 35% 30%,#ff5757,#9d0000 70%); box-shadow:0 0 70px rgba(255,42,42,.22), inset 0 0 40px rgba(0,0,0,.35); font-size:1.4rem; font-weight:900; letter-spacing:.15em; }
@keyframes spin { to { transform:rotate(360deg); } }
@media (max-width:768px){ .hero-cursor-glow{display:none;} .hero-grid{background-size:46px 46px;} }
@media (prefers-reduced-motion:reduce){ *,*::before,*::after{scroll-behavior:auto!important;animation-duration:.001ms!important;animation-iteration-count:1!important;transition-duration:.001ms!important;} }

/* Interactive engineering universe */
.skill-universe{position:relative;height:700px;overflow:hidden;background:#050505;border-top:1px solid rgba(255,255,255,.06);border-bottom:1px solid rgba(255,255,255,.06);isolation:isolate}
.skill-universe.compact{height:560px}
.skill-universe:before{content:'';position:absolute;inset:0;background:radial-gradient(circle at 50% 50%,rgba(255,42,42,.12),transparent 22%),radial-gradient(circle at 20% 20%,rgba(255,255,255,.04),transparent 25%),linear-gradient(rgba(255,255,255,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.035) 1px,transparent 1px);background-size:auto,auto,70px 70px,70px 70px;mask-image:linear-gradient(to bottom,transparent,black 15%,black 85%,transparent)}
.skill-depth{position:absolute;border-radius:50%;filter:blur(1px);pointer-events:none}.skill-depth-a{width:650px;height:650px;left:50%;top:50%;margin:-325px;background:radial-gradient(circle,rgba(255,42,42,.12),transparent 62%);animation:universePulse 7s ease-in-out infinite}.skill-depth-b{width:900px;height:900px;left:50%;top:50%;margin:-450px;border:1px solid rgba(255,255,255,.035);box-shadow:0 0 120px rgba(255,42,42,.06) inset}
.skill-stars{position:absolute;inset:0;opacity:.65;background-image:radial-gradient(circle,rgba(255,255,255,.65) 1px,transparent 1.5px),radial-gradient(circle,rgba(255,42,42,.5) 1px,transparent 1.5px);background-size:83px 97px,131px 149px;background-position:17px 23px,60px 80px;animation:starDrift 24s linear infinite}
.skill-orbit{position:absolute;left:50%;top:50%;border:1px solid rgba(255,255,255,.12);border-radius:50%;transform:translate(-50%,-50%) rotateX(66deg);box-shadow:0 0 50px rgba(255,42,42,.04)}.orbit-one{width:420px;height:420px;animation:orbitSpin 18s linear infinite}.orbit-two{width:560px;height:330px;border-style:dashed;animation:orbitSpin 26s linear infinite reverse}.orbit-three{width:700px;height:210px;opacity:.55;animation:orbitSpin 34s linear infinite}
.skill-core-wrap{position:absolute;left:50%;top:50%;width:150px;height:150px;transform:translate(-50%,-50%);display:grid;place-items:center}.skill-core-ring{position:absolute;inset:-22px;border:1px solid rgba(255,42,42,.4);border-radius:50%;box-shadow:0 0 45px rgba(255,42,42,.12);animation:coreSpin 9s linear infinite}.skill-core{width:128px;height:128px;border-radius:50%;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;background:radial-gradient(circle at 35% 25%,#ff5353,#7e0000 68%,#240000);box-shadow:0 0 80px rgba(255,42,42,.3),inset 0 0 35px rgba(0,0,0,.4);border:1px solid rgba(255,255,255,.18)}.skill-core span{font-size:29px;font-weight:1000;letter-spacing:.18em;margin-left:.18em}.skill-core small{font-size:6px;line-height:1.5;letter-spacing:.22em;color:rgba(255,255,255,.62);margin-top:5px}
.skill-node-universe{position:absolute;inset:0;transform-style:preserve-3d;perspective:1100px;will-change:transform;z-index:8;pointer-events:none}.skill-node-layer{position:absolute;left:50%;top:50%;width:0;height:0;transform-style:preserve-3d;pointer-events:none}.skill-node{position:absolute;pointer-events:auto;opacity:1;visibility:visible;left:0;top:0;white-space:nowrap;border:1px solid rgba(255,255,255,.12);background:rgba(8,8,8,.72);backdrop-filter:none;color:rgba(255,255,255,.66);padding:8px 12px;border-radius:999px;font:700 10px/1 Inter,system-ui,sans-serif;letter-spacing:.04em;cursor:pointer;transition:color .25s,border-color .25s,background .25s,box-shadow .25s}.skill-node:hover,.skill-node:focus-visible,.skill-node.is-hot{color:#fff;border-color:rgba(255,42,42,.7);background:rgba(255,42,42,.13);box-shadow:0 0 28px rgba(255,42,42,.16);outline:none}
.skill-universe-caption{position:absolute;left:6%;bottom:48px;display:flex;flex-direction:column;gap:5px}.skill-universe-caption span{font:700 9px/1 Inter,sans-serif;letter-spacing:.35em;color:rgba(255,255,255,.28)}.skill-universe-caption b{font:900 18px/1 Inter,sans-serif;color:#fff}
.terminal-section{display:grid;grid-template-columns:.7fr 1.3fr;gap:60px;align-items:center;padding:130px max(6vw,24px);background:#080808;border-top:1px solid rgba(255,255,255,.06)}.terminal-copy .eyebrow{font:800 10px/1 Inter;letter-spacing:.35em;color:#ff5555}.terminal-copy h2{font:1000 clamp(3.5rem,7vw,7rem)/.82 Inter,sans-serif;letter-spacing:-.07em;margin:22px 0}.terminal-copy h2 em{font-style:normal;color:transparent;-webkit-text-stroke:1px rgba(255,255,255,.8)}.terminal-copy p{max-width:390px;color:rgba(255,255,255,.45);line-height:1.7}.terminal-window{border:1px solid rgba(255,255,255,.12);background:#030303;box-shadow:0 30px 100px rgba(0,0,0,.5);min-height:400px}.terminal-bar{height:42px;border-bottom:1px solid rgba(255,255,255,.08);display:flex;align-items:center;gap:7px;padding:0 15px}.terminal-bar span{width:8px;height:8px;border-radius:50%;background:rgba(255,255,255,.22)}.terminal-bar span:first-child{background:#ff4a4a}.terminal-bar label{margin-left:auto;font:700 9px/1 monospace;letter-spacing:.18em;color:rgba(255,255,255,.3)}.terminal-body{padding:24px;font:13px/1.6 ui-monospace,SFMono-Regular,Menlo,monospace;min-height:358px}.terminal-line{margin-bottom:18px}.terminal-line b{color:#ff5a5a}.terminal-line span{color:rgba(255,255,255,.42)}.terminal-line pre{white-space:pre-wrap;margin:5px 0 0;color:rgba(255,255,255,.72);font:inherit}.terminal-input{display:flex;gap:9px;align-items:center;color:#ff5a5a}.terminal-input input{flex:1;min-width:0;background:transparent;border:0;outline:0;color:#fff;font:inherit}.terminal-input input::placeholder{color:rgba(255,255,255,.18)}
@keyframes universePulse{50%{transform:scale(1.08);opacity:.75}}@keyframes starDrift{to{background-position:100px 160px,220px 250px}}@keyframes orbitSpin{to{transform:translate(-50%,-50%) rotateX(66deg) rotateZ(360deg)}}@keyframes coreSpin{to{transform:rotateZ(360deg)}}
@media(max-width:900px){.terminal-section{grid-template-columns:1fr;gap:35px;padding:90px 24px}.skill-universe{height:620px}.skill-node{font-size:9px;padding:7px 9px}.skill-orbit.orbit-three{width:580px}.skill-universe-caption{left:24px;bottom:28px}}
@media(max-width:640px){.skill-universe{height:600px}.skill-orbit.orbit-one{width:300px;height:300px}.skill-orbit.orbit-two{width:390px;height:240px}.skill-orbit.orbit-three{width:480px;height:180px}.skill-node{font-size:8px;padding:6px 8px}.skill-universe-caption{bottom:18px}.terminal-body{padding:16px;font-size:11px}}
@media(prefers-reduced-motion:reduce){.skill-stars,.skill-depth-a,.skill-orbit,.skill-core-ring{animation:none}.skill-node-universe{animation:none!important;transform:none!important}.skill-node{transition:none}}
.hero-grid-depth{will-change:transform}.hero-world-stars{pointer-events:none;opacity:.42;background-image:radial-gradient(circle,rgba(255,255,255,.6) 1px,transparent 1.5px),radial-gradient(circle,rgba(255,42,42,.4) 1px,transparent 1.5px);background-size:96px 110px,170px 180px;background-position:20px 10px,80px 100px;mix-blend-mode:screen;animation:worldDrift 30s linear infinite}.hero-grid{will-change:transform;transform-origin:center}@keyframes worldDrift{to{background-position:160px 220px,260px 310px}}

/* Cinematic world-scroll: sections feel like entering successive spaces, not flat slides. */
html { scroll-behavior: auto; }
body { background:#020202; }
.world-chapter {
  position:relative;
  transform: translate3d(0,var(--world-y,0px),0) rotateX(var(--world-rotate,0deg)) scale(var(--world-scale,1));
  transform-origin:50% 50%;
  filter: none;
  opacity:var(--world-depth,1);
  will-change:transform,opacity;
  transition:none;
  perspective:1200px;
}
.world-chapter::before {
  content:''; position:absolute; inset:0; pointer-events:none; z-index:90; opacity:0;
  background:radial-gradient(ellipse at center,transparent 48%,rgba(0,0,0,.36) 100%);
  transition:opacity .25s ease;
}
.world-portal { z-index:4; }
.world-chrome { position:fixed; inset:0; pointer-events:none; z-index:80; }
.world-chrome::before {
  content:''; position:absolute; inset:0;
  background:radial-gradient(circle at 50% 50%,transparent 35%,rgba(0,0,0,.18) 72%,rgba(0,0,0,.55) 100%);
  opacity:.72;
}
.world-chrome-line {
  position:absolute; left:50%; top:0; width:1px; height:100%;
  background:linear-gradient(to bottom,transparent,rgba(255,42,42,.22) 35%,rgba(255,255,255,.08) 50%,rgba(255,42,42,.22) 65%,transparent);
  transform:translateX(-50%); opacity:.22;
}
.world-chrome-dot {
  position:absolute; left:50%; top:calc(var(--scroll-progress,0) * 100%); width:5px; height:5px;
  border-radius:50%; background:#ff2a2a; box-shadow:0 0 20px #ff2a2a; transform:translate(-50%,-50%);
}
.world-portal .skill-universe { box-shadow:0 0 0 1px rgba(255,255,255,.03),0 -40px 120px rgba(255,42,42,.08),0 40px 120px rgba(255,42,42,.08); }
@media (prefers-reduced-motion: reduce) {
  .world-chapter { transform:none !important; filter:none !important; opacity:1 !important; transition:none !important; }
  .world-chrome { display:none; }
}

/* Solar-system skill universe */
.solar-system{height:760px;overflow:hidden;position:relative;background:#030305;isolation:isolate}
.solar-system:before{content:'';position:absolute;inset:0;background:radial-gradient(circle at 50% 50%,rgba(255,42,42,.13),transparent 16%),radial-gradient(circle at 50% 50%,rgba(255,255,255,.035),transparent 48%),linear-gradient(rgba(255,255,255,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.025) 1px,transparent 1px);background-size:auto,auto,64px 64px,64px 64px;pointer-events:none}
.solar-system:after{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at center,transparent 38%,rgba(0,0,0,.42) 100%);pointer-events:none}
.solar-system-stage{position:absolute;left:50%;top:50%;width:0;height:0;transform-style:preserve-3d;perspective:1400px;z-index:3;will-change:transform}
.solar-nebula{position:absolute;width:720px;height:720px;left:-360px;top:-360px;border-radius:50%;background:radial-gradient(circle,rgba(255,38,38,.08),transparent 55%);filter:blur(1px);pointer-events:none}
.solar-orbit{position:absolute;left:50%;top:50%;border:1px solid rgba(255,255,255,.12);border-radius:50%;transform-style:preserve-3d;animation-name:solarOrbit;animation-timing-function:linear;animation-iteration-count:infinite;will-change:transform;pointer-events:none;box-shadow:0 0 28px rgba(255,42,42,.025)}
.orbit-line{position:absolute;inset:-1px;border-radius:50%;border-top:1px solid rgba(255,42,42,.3);border-bottom:1px solid rgba(255,255,255,.025);pointer-events:none}
.skill-planet{position:absolute;left:50%;top:50%;width:1px;height:1px;transform-style:preserve-3d;pointer-events:none}
.skill-node-label{position:absolute;left:-50%;top:-50%;min-width:max-content;transform:translate(-50%,-50%);pointer-events:auto;white-space:nowrap;border:1px solid rgba(255,255,255,.14);background:rgba(5,5,7,.9);color:rgba(255,255,255,.82);padding:8px 12px;border-radius:999px;font:800 10px/1 Inter,system-ui,sans-serif;letter-spacing:.045em;cursor:pointer;box-shadow:0 6px 22px rgba(0,0,0,.32);transition:color .2s,border-color .2s,background .2s,box-shadow .2s;backface-visibility:visible;opacity:1!important;visibility:visible!important}
.skill-node-label:hover,.skill-node-label:focus-visible,.skill-node-label.is-hot{color:#fff;border-color:rgba(255,70,70,.9);background:rgba(95,8,8,.96);box-shadow:0 0 24px rgba(255,42,42,.28),0 6px 24px rgba(0,0,0,.42);outline:none}
.solar-sun-wrap{position:absolute;left:50%;top:50%;width:180px;height:180px;transform:translate(-50%,-50%);display:grid;place-items:center;z-index:100;pointer-events:none}
.solar-corona{position:absolute;width:230px;height:230px;border-radius:50%;background:radial-gradient(circle,rgba(255,54,54,.28),rgba(255,30,30,.07) 42%,transparent 70%);animation:solarPulse 4s ease-in-out infinite}
.solar-sun{width:132px;height:132px;border-radius:50%;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;background:radial-gradient(circle at 35% 25%,#ff7777 0,#ff3131 28%,#9b0707 65%,#310000 100%);border:1px solid rgba(255,255,255,.3);box-shadow:0 0 50px rgba(255,42,42,.38),0 0 120px rgba(255,42,42,.16),inset -16px -20px 35px rgba(0,0,0,.35);animation:sunFloat 5s ease-in-out infinite}
.solar-sun span{font-size:29px;font-weight:1000;letter-spacing:.18em;margin-left:.18em;color:#fff}.solar-sun small{font-size:6px;line-height:1.5;letter-spacing:.22em;color:rgba(255,255,255,.68);margin-top:5px}
.solar-system-caption{position:absolute;left:6%;bottom:46px;z-index:10;display:flex;flex-direction:column;gap:6px}.solar-system-caption span{font:800 9px/1 Inter,sans-serif;letter-spacing:.34em;color:rgba(255,255,255,.3)}.solar-system-caption b{font:900 18px/1 Inter,sans-serif;color:#fff}
@keyframes solarOrbit{from{transform:rotate(var(--orbit-tilt,0deg)) rotateZ(0deg)}to{transform:rotate(var(--orbit-tilt,0deg)) rotateZ(360deg)}}
@keyframes solarPulse{0%,100%{transform:scale(.96);opacity:.72}50%{transform:scale(1.03);opacity:.92}}
@keyframes sunFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-3px)}}
@media(max-width:900px){.solar-system{height:660px}.solar-orbit:nth-of-type(6){display:none}.solar-system-stage{transform:scale(.78)}.solar-system-caption{left:24px;bottom:28px}}
@media(max-width:640px){.solar-system{height:620px}.solar-system-stage{transform:scale(.55)}.solar-system-caption{left:18px;bottom:18px}.skill-node-label{font-size:9px;padding:7px 9px}}
@media(prefers-reduced-motion:reduce){.solar-orbit{animation:none}.solar-corona,.solar-sun{animation:none}}

/* Butter-smooth motion pass */
.world-chapter{backface-visibility:hidden;transform-style:preserve-3d;contain:paint;}
.solar-system-stage{animation:solarStageFloat 12s ease-in-out infinite;}
.skill-node-label{will-change:transform;}
@keyframes solarStageFloat{0%,100%{translate:0 0}50%{translate:0 -3px}}
@media(prefers-reduced-motion:reduce){.solar-system-stage{animation:none}.world-chapter{transform:none!important}}

/* Premium smoothness pass */
html { scroll-behavior: smooth; }
body { overscroll-behavior-y: none; }
.world-chapter { contain: layout paint style; }
.world-chapter > * { transform: translateZ(0); }
.case-card { transform: translateZ(0); }
.case-step { transition: transform .45s cubic-bezier(.22,1,.36,1), border-color .45s ease, background .45s ease; }
.case-card:hover .case-step { transform: translateY(-2px); border-color: rgba(255,42,42,.18); }
.solar-orbit { animation-timing-function: linear; }
.solar-system-stage { transform-style: preserve-3d; }
.solar-nebula { animation: nebulaBreathe 14s ease-in-out infinite; }
.solar-corona { animation: solarPulse 7s ease-in-out infinite; }
.solar-sun { animation: sunFloat 8s ease-in-out infinite; }
@keyframes nebulaBreathe { 0%,100% { opacity:.72; transform:scale(.98); } 50% { opacity:1; transform:scale(1.025); } }
@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  .solar-nebula,.solar-corona,.solar-sun { animation:none; }
}

/* Core-skill solar system: fewer, larger, calmer planets. */
.skill-node-label::before { content:''; display:inline-block; width:5px; height:5px; margin-right:7px; border-radius:50%; background:rgba(255,70,70,.75); box-shadow:0 0 8px rgba(255,42,42,.45); vertical-align:1px; }
.skill-node-label { transform:translate(-50%,-50%) translateZ(0); }
.skill-node-label:hover::before,.skill-node-label:focus-visible::before { background:#fff; box-shadow:0 0 10px rgba(255,255,255,.8); }
@media(max-width:900px){.solar-system-stage{transform:scale(.72)} }
@media(max-width:640px){.solar-system-stage{transform:scale(.52)} }

/* Cinematic camera scroll v2 — continuous depth, not card sliding. */
html { scroll-behavior: auto; }
.world-chapter {
  transform:
    perspective(1800px)
    translate3d(0, var(--world-y, 0px), var(--world-z, 0px))
    rotateX(var(--world-rotate-x, 0deg))
    rotateY(var(--world-rotate-y, 0deg))
    scale(var(--world-scale, 1));
  transform-origin: 50% 50%;
  transform-style: preserve-3d;
  opacity: var(--world-opacity, 1);
  filter: blur(var(--world-blur, 0px)) saturate(var(--world-saturate, 1));
  will-change: transform, opacity, filter;
  backface-visibility: hidden;
  contain: layout paint style;
}
.world-chapter::before {
  opacity: calc((1 - var(--world-edge, 1)) * .55);
  transition: opacity .12s linear;
  background:
    radial-gradient(ellipse at center, transparent 38%, rgba(0,0,0,.28) 100%),
    linear-gradient(to bottom, rgba(255,42,42,.045), transparent 18%, transparent 82%, rgba(255,42,42,.045));
}
.world-chapter::after {
  content:'';
  position:absolute;
  inset:0;
  pointer-events:none;
  z-index:89;
  opacity:calc(var(--scroll-velocity, 0) * .12);
  background:linear-gradient(90deg, transparent 0%, rgba(255,255,255,.025) 50%, transparent 100%);
  transform:translateX(calc(var(--camera-drift, 0deg) * 18));
  mix-blend-mode:screen;
}
.world-chrome::before {
  opacity: calc(.58 + var(--scroll-velocity, 0) * .12);
}
.world-chrome-line {
  transform:translateX(-50%) skewX(var(--camera-drift, 0deg));
  transition:transform .08s linear;
}
.world-portal .solar-system {
  transform: translateZ(18px);
}

/* Give major sections a continuous visual field instead of hard stops. */
.world-chapter + .world-chapter::before {
  box-shadow: inset 0 28px 70px rgba(0,0,0,.16), inset 0 -28px 70px rgba(0,0,0,.16);
}

@media (prefers-reduced-motion: reduce) {
  .world-chapter {
    transform:none !important;
    filter:none !important;
    opacity:1 !important;
  }
  .world-chapter::after { display:none; }
}
